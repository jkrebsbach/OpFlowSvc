  <DataSets>
    <DataSet Name="CardRedundancy">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'aaaabc' as CardName, 'zzz' as InstrumentName, 'ddd' as TrayName, 5 as Quantity, 3.5 as Usage, 3 as TrayOpen
UNION
select 'aaaabc' as CardName, 'zzz' as InstrumentName, 'eee' as TrayName, 6 as Quantity, 3.5 as Usage, 3 as TrayOpen
UNION
select 'aaaabc' as CardName, 'zzz' as InstrumentName, 'fff' as TrayName, 7 as Quantity, 3.5 as Usage, 3 as TrayOpen</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CardName">
          <DataField>CardName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstrumentName">
          <DataField>InstrumentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Usage">
          <DataField>Usage</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TrayOpen">
          <DataField>TrayOpen</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
