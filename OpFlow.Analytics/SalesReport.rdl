    <DataSet Name="Subscription">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'A' as cost_type, 1234 subscription, 1 year, 
123 value_1, 123 value_2, 123 value_3, 123 value_4, 123 value_5</CommandText>
