  <DataSets>
    <DataSet Name="ServiceLineReview">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>SELECT 
	'Item' ItemName,
	5 SpecialtyID,
	'Specialty' Specialty,
	'Card' CardName,
'Surgeon' Surgeon,
	'Procedure' ProcedureName,
	'item 5 cnts cost $5.15' CustomLegend,
	6 CardQuantity,
	5 ItemCost,
	2.1 AvgHold,
	2.2 AvgSetup,
	2.3 AvgSetupOpen,
	2.4 AvgSetupAdded,
	2.5 AvgOpen,
	2.6 AvgOpenInit,
	2.7 AvgOpenAdded,
	2.8 AvgOpenVariance,
	2.9 AvgUsageVariance,
	3.1 AvgCardQtyVariance,
	3.2 AvgUsed,
	3.3 UsageVariance,
	4.0 CardQtyVariance,
	6 CaseCount</CommandText>
      </Query>
