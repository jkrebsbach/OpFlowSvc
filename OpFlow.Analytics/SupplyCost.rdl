<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3500da5b-bc9e-4ab6-a224-26af254fa41b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SupplyCost">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>
select 
	specialty.description Specialty,
	card.description CardName,
	IsNull(surgeon.title, '') + ' ' + IsNull(surgeon.last_name, '') +  ', ' + IsNull(surgeon.first_name, '') Surgeon,
	SUM(item_master.unit_cost) CardCost
	
from users surgeon
join card ON surgeon.user_id = card.owner_user_id
join card_item ON card.card_id = card_item.card_id
join specialty ON surgeon.specialty_id = specialty.specialty_id
join item_master ON card_item.item_id = item_master.item_id
WHERE 1 = surgeon.provider_id
	AND 1 = surgeon.location_id
	AND surgeon.specialty_id = 1
	AND surgeon.user_id = 4
GROUP BY specialty.description, card.description, 
	surgeon.title, surgeon.last_name, surgeon.first_name
ORDER BY card.description</CommandText>
      </Query>
      <Fields>
        <Field Name="Specialty">
          <DataField>Specialty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Surgeon">
          <DataField>Surgeon</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CardName">
          <DataField>CardName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CardCost">
          <DataField>CardCost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
