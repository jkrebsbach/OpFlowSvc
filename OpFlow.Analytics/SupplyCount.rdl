  <DataSets>
    <DataSet Name="SupplyCount">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'YYY' CategoryName, 'AAA' ItemName, 52 CaseCount
UNION
select 'ZZZ' CategoryName, 'BBB' ItemName, 14 CaseCount</CommandText>
      </Query>
      <Fields>
