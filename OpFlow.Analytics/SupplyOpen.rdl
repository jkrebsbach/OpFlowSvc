<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e402514c-2889-41e8-8678-2752ca151e5c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SupplyOpen">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select CASE 'I' WHEN 'I' THEN item_master.description
	ELSE card.description + '\n' +
	item_master.description 
	END ItemName,
'This is a thing' CustomLegend,
	specialty.description Specialty,
	item_master.unit_cost ItemCost,
	card.description CardName,
	card_item.qty_open CardQuantity,
3.1 AvgSetup,
3.1 AvgSetupOpen,
2.1 AvgSetupAdded,
4.1 AvgOpen,
4.1 AvgOpenInit,
6.1 AvgOpenAdded,
4.1 AvgOpenVariance,
4.1 AvgUsageVariance,
-1.2 AvgCardQtyVariance,
40 UsageVariance,
72 CaseCount
from surgery s
JOIN surgery_card_item_counts scic ON s.surgery_id = scic.surgery_id
	AND scic.type = 'U'
join users surgeon ON s.user_id = surgeon.user_id
join card ON s.card_id = card.card_id
join card_item ON card.card_id = card_item.card_id
	AND card_item.item_id = scic.item_id
join specialty ON surgeon.specialty_id = specialty.specialty_id
join item_master ON scic.item_id = item_master.item_id
WHERE 1 = surgeon.provider_id
	AND 1 = surgeon.location_id
ORDER BY CASE 'I' WHEN 'I' THEN card.description ELSE NULL END, item_master.description</CommandText>
      </Query>
      <Fields>
        <Field Name="ItemName">
          <DataField>ItemName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CustomLegend">
          <DataField>CustomLegend</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
