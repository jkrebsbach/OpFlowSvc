<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3e07071b-ea4d-4a16-8fef-b74011888c61</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SupplyWaste">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select CASE 'I' WHEN 'I' THEN item_master.description
	ELSE card.description + '\n' +
	item_master.description 
	END ItemName,
	specialty.description Specialty,
	IsNull(item_master.unit_cost, 0.0) ItemCost,
	card.description CardName,
	card_item.qty_open CardQuantity,
	CASE WHEN IsNull(card_item.qty_hold, '0') = '0' THEN 0
		WHEN card_item.qty_open &lt; scic.qty_used THEN 0
		ELSE card_item.qty_open - scic.qty_used END HoldUsed,
	CASE WHEN IsNull(card_item.qty_hold, '0') &lt;&gt; '0' THEN 0
		WHEN card_item.qty_open &lt; scic.qty_used THEN 0
		ELSE card_item.qty_open - scic.qty_used
	END TotalAdded,
	scic.qty_used TotalUsed,
	1 Bleeding ,
	1 Anatomy ,
	1 Preference ,
	1 CirculatorOpened,
	1 ScrubRequest,
	1 Error,
	1 Extra,
	1 Needed,
	1 NoTrust,
	1 Miscommunication,
	1 Surgeon,
	1 Circulator,
	1 Scrub
from surgery s
JOIN surgery_card_item_counts scic ON s.surgery_id = scic.surgery_id
	AND scic.type = 'U'
join users surgeon ON s.user_id = surgeon.user_id
join card ON s.card_id = card.card_id
join card_item ON card.card_id = card_item.card_id
	AND card_item.item_id = scic.item_id
join specialty ON surgeon.specialty_id = specialty.specialty_id
join item_master ON scic.item_id = item_master.item_id
WHERE 1 = surgeon.provider_id
	AND 1 = surgeon.location_id
ORDER BY CASE 'I' WHEN 'I' THEN card.description ELSE NULL END, item_master.description</CommandText>
      </Query>
