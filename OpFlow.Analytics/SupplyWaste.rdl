<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3e07071b-ea4d-4a16-8fef-b74011888c61</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SupplyWaste">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select top 10 instrument_master.description InstrumentName,
	instrument_master.instrument_cost InstrumentCost,
	card.description CardName,
	ti.quantity TrayQuantity,
	vw.total_used TotalUsed
from card_instrument_usage_view vw
join tray_instruments ti ON ti.instrument_id = vw.instrument_id AND
	ti.tray_item_id = vw.tray_item_id
join card ON vw.card_id = card.card_id
join instrument_master ON vw.instrument_id = instrument_master.instrument_id
</CommandText>
      </Query>
      <Fields>
        <Field Name="InstrumentName">
          <DataField>InstrumentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstrumentCost">
          <DataField>InstrumentCost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CardName">
          <DataField>CardName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TrayQuantity">
          <DataField>TrayQuantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalUsed">
          <DataField>TotalUsed</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
