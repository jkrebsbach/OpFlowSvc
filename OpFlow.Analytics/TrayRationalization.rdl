<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>aaf72f52-fbd2-4a83-9ee0-c295afd65466</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="TrayRationalization">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>
SELECT TrayName,
	SUM(CaseCount) CaseCount,
	MAX(InstrumentCount) InstrumentCount,
	AVG(UsageQuantity ) UsageQuantity,
	SUM(TrayOpened) TrayOpened
FROM tray_rationalization_view
WHERE SpecialtyID=1
GROUP BY TrayName
ORDER BY TrayName</CommandText>
      </Query>
      <Fields>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CaseCount">
          <DataField>CaseCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InstrumentCount">
          <DataField>InstrumentCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UsageQuantity">
          <DataField>UsageQuantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TrayOpened">
          <DataField>TrayOpened</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
