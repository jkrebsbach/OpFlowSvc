<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <style name="OpFlowTheme" parent="android:Theme.Material.Light">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:colorPrimary">@color/opflow_black</item>
    <item name="android:colorBackground">@color/opflow_white</item>
    
    <item name="android:actionBarStyle">@style/ActionBarTheme</item>
  </style>
  <style name="ActionBarTheme" parent="@android:style/Widget.Holo.Light.ActionBar">
    <item name="android:background">@color/opflow_blue</item>
  </style>
  <!-- ToolBar -->
  <style name="ToolBarStyle" parent="@android:style/Widget.Holo.Light.ActionBar">
    <item name="android:colorAccent">@color/opflow_black</item>
    <item name="android:colorPrimary">@color/opflow_black</item>
    <item name="android:colorPrimaryDark">@color/opflow_black</item>
  </style>
</resources>