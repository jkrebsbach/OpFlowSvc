<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <style name="OpFlowTheme" parent="android:Theme.Material.Light">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:colorPrimary">@color/opflow_black</item>
    <item name="android:colorBackground">@color/opflow_white</item>
    <item name="android:textSize">8sp</item>
    
    <item name="android:actionBarStyle">@style/ToolBarStyle</item>
  </style>
  <!-- ToolBar -->
  <style name="ToolBarStyle" parent="@android:style/Widget.Holo.Light.ActionBar">
    <item name="android:colorAccent">@color/opflow_blue</item>
    <item name="android:actionBarSize">30dip</item>
    <item name="android:background">?android:attr/colorAccent</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textColor">@color/opflow_white</item>
  </style>
  <style name="TextView.Header" parent="android:Widget.TextView">
    <item name="android:textSize">15sp</item>
    <item name="android:layout_gravity">center</item>
  </style>
  <style name="TextView.Calendar" parent="@style/TextView.Header" >
  </style>
</resources>