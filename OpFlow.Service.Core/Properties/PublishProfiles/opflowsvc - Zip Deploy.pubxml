<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://opflowsvc.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ProjectGuid>48366189-a793-45d0-8bbe-a2740d554eaa</ProjectGuid>
    <PublishUrl>https://opflowsvc.scm.azurewebsites.net/</PublishUrl>
    <UserName>$opflowsvc</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>