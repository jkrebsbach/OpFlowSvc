  <DataSets>
    <DataSet Name="ProcedureProfile">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'aaa' TrayName, 
123 InstrumentCount, 
45.36 AvgUsage,
16 Variance,
12.45 InstrumentCost
UNION
select 'bbb' TrayName, 
213 InstrumentCount, 
45.36 AvgUsage,
16 Variance,
21.45 InstrumentCost</CommandText>
      </Query>
      <Fields>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstrumentCount">
          <DataField>InstrumentCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AvgUsage">
          <DataField>AvgUsage</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="InstrumentCost">
          <DataField>InstrumentCost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Variance">
          <DataField>Variance</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
