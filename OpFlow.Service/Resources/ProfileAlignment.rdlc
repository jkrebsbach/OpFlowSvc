  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bc6f252c-ec0f-49c4-87c9-be3e6591391b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Alignment">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'Card A' CardName,
   'Scissor' ItemName,
   3 OPP_Qty,
   3 AVG_Qty,
   3 ORIG_Qty

UNION

select 'Card B' CardName,
   'Scissor' ItemName,
   4 OPP_Qty,
   2.2 AVG_Qty,
   5 ORIG_Qty

UNION

select 'Card A' CardName,
   'Scalpel' ItemName,
   6 OPP_Qty,
   1.2 AVG_Qty,
   5 ORIG_Qty

UNION

select 'Card B' CardName,
   'Scalpel' ItemName,
   4 OPP_Qty,
   1.2 AVG_Qty,
   3 ORIG_Qty</CommandText>
      </Query>
      <Fields>
        <Field Name="CardName">
          <DataField>CardName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemName">
          <DataField>ItemName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OPP_Qty">
          <DataField>OPP_Qty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AVG_Qty">
          <DataField>AVG_Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ORIG_Qty">
          <DataField>ORIG_Qty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
