  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7dee3b8f-847d-47ae-9895-42e57c35c851</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ServiceLineReview">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>SELECT 
	'Item' ItemName,
	5 SpecialtyID,
	'Specialty' Specialty,
'Surgeon' Surgeon,
	'Card' CardName,
	'Procedure' ProcedureName,
	6 CardQuantity,
	5 ItemCost,
	2.2 AvgSetup,
	2.5 AvgOpen,
	2.9 AvgUsageVariance,
	3.1 AvgCardQtyVariance,
	3.2 AvgUsed,
	3 UsageVariance,
	3 WasteAmount,
	3 OverAllocation,
	4 UnderAllocation,
	6 CaseCount

UNION ALL
SELECT 
	'Item' ItemName,
	5 SpecialtyID,
	'Specialty2' Specialty,
'Surgeon' Surgeon,
	'Card' CardName,
	'Procedure' ProcedureName,
	6 CardQuantity,
	5 ItemCost,
	2.2 AvgSetup,
	2.5 AvgOpen,
	2.9 AvgUsageVariance,
	3.1 AvgCardQtyVariance,
	3.2 AvgUsed,
	3 UsageVariance,
	0.3 WasteAmount,
	0.3 OverAllocation,
	0.4 UnderAllocation,
	6 CaseCount

UNION ALL
SELECT 
	'Item' ItemName,
	5 SpecialtyID,
	'Specialty3' Specialty,
'Surgeon' Surgeon,
	'Card' CardName,
	'Procedure' ProcedureName,
	6 CardQuantity,
	5 ItemCost,
	2.2 AvgSetup,
	2.5 AvgOpen,
	2.9 AvgUsageVariance,
	3.1 AvgCardQtyVariance,
	3.2 AvgUsed,
	3 UsageVariance,
	30 WasteAmount,
	30 OverAllocation,
	40 UnderAllocation,
	6 CaseCount</CommandText>
      </Query>
