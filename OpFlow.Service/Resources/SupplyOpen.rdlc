<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="OpFlow"><DataSourceReference>OpFlow</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>e402514c-2889-41e8-8678-2752ca151e5c</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="SupplyOpen"><Query><DataSourceName>OpFlow</DataSourceName><CommandText>select CASE 'I' WHEN 'I' THEN item_master.description
	ELSE card.description + '\n' +
	item_master.description 
	END ItemName,
'This is a thing' CustomLegend,
	specialty.description Specialty,
	item_master.unit_cost ItemCost,
	card.description CardName,
	card_item.qty_open CardQuantity,
3.1 AvgSetup,
3.1 AvgSetupOpen,
2.1 AvgSetupAdded,
4.1 AvgOpen,
4.1 AvgOpenInit,
6.1 AvgOpenAdded,
4.1 AvgOpenVariance,
4.1 AvgUsageVariance,
-1.2 AvgCardQtyVariance,
40 UsageVariance,
17 CardQtyVariance,
72 CaseCount
from surgery s
JOIN surgery_card_item_counts scic ON s.surgery_id = scic.surgery_id
	AND scic.type = 'U'
join users surgeon ON s.user_id = surgeon.user_id
join card ON s.card_id = card.card_id
join card_item ON card.card_id = card_item.card_id
	AND card_item.item_id = scic.item_id
join specialty ON surgeon.specialty_id = specialty.specialty_id
join item_master ON scic.item_id = item_master.item_id
WHERE 1 = surgeon.provider_id
	AND 1 = surgeon.location_id
ORDER BY CASE 'I' WHEN 'I' THEN card.description ELSE NULL END, item_master.description</CommandText></Query><Fields><Field Name="ItemName"><DataField>ItemName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CustomLegend"><DataField>CustomLegend</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Specialty"><DataField>Specialty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ItemCost"><DataField>ItemCost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="CardName"><DataField>CardName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CardQuantity"><DataField>CardQuantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="AvgSetup"><DataField>AvgSetup</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgSetupOpen"><DataField>AvgSetupOpen</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgSetupAdded"><DataField>AvgSetupAdded</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgOpenInit"><DataField>AvgOpenInit</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgOpen"><DataField>AvgOpen</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgOpenAdded"><DataField>AvgOpenAdded</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgOpenVariance"><DataField>AvgOpenVariance</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgUsageVariance"><DataField>AvgUsageVariance</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AvgCardQtyVariance"><DataField>AvgCardQtyVariance</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="UsageVariance"><DataField>UsageVariance</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="CardQtyVariance"><DataField>CardQtyVariance</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="CaseCount"><DataField>CaseCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>4.98959in</Width></TablixColumn><TablixColumn><Width>4.25in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Specialty"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Specialty.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Specialty</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox4</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total Savings Opportunity</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox2</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox5</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Total units opened but not used " &amp; SUM(Fields!UsageVariance.Value, "Specialty") &amp;
" = $" &amp; Format(SUM(Fields!UsageVariance.Value * Fields!ItemCost.Value, "Specialty"), "#,###.00") &amp;
" for the " &amp; MAX(Fields!CaseCount.Value, "Specialty") &amp; " cases we audited"</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox3</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox6</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Total units allocated but not needed " &amp; SUM(Fields!CardQtyVariance.Value, "Specialty") &amp;
" = $" &amp; Format(SUM(Fields!CardQtyVariance.Value * Fields!ItemCost.Value, "Specialty"), "#,###.00") &amp;
" for the " &amp; MAX(Fields!CaseCount.Value, "Specialty") &amp; " cases we audited"</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox7</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>8.96875in</Height><TablixCells><TablixCell><CellContents><Chart Name="Chart1"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart1_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!CustomLegend.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!CustomLegend.Value</Value></SortExpression></SortExpressions><Label>=Fields!CustomLegend.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Avg Setup</Label></ChartMember><ChartMember><Label>Avg Open</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="Setup"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Max(Fields!AvgSetup.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontSize>8pt</FontSize><