  <DataSets>
    <DataSet Name="SupplySavings">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>
select 
	'XYZ' ItemName,
	5 CardQty,
	2.53 QtySetup,
	1.53 QtyOpen,
	3.53 UnitCost,
21 CaseCount
	</CommandText>
      </Query>
      <Fields>
        <Field Name="QtyOpen">
          <DataField>QtyOpen</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ItemName">
          <DataField>ItemName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CardQty">
          <DataField>CardQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QtySetup">
          <DataField>QtySetup</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="UnitCost">
          <DataField>UnitCost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CaseCount">
          <DataField>CaseCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
