                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!CardQty.Value</Value>
                                  <Style />
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CardQty</rd:DefaultName>
