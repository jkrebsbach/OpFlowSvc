<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="OpFlow"><DataSourceReference>OpFlow</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3e07071b-ea4d-4a16-8fef-b74011888c61</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="SupplyWaste"><Query><DataSourceName>OpFlow</DataSourceName><CommandText>select CASE 'I' WHEN 'I' THEN item_master.description
	ELSE card.description + '\n' +
	item_master.description 
	END ItemName,
	specialty.description Specialty,
	item_master.unit_cost ItemCost,
	card.description CardName,
	card_item.qty_open CardQuantity,
	scic.qty_open TotalUsed
from surgery s
JOIN surgery_card_item_counts scic ON s.surgery_id = scic.surgery_id
	AND scic.type = 'U'
join users surgeon ON s.user_id = surgeon.user_id
join card ON s.card_id = card.card_id
join card_item ON card.card_id = card_item.card_id
	AND card_item.item_id = scic.item_id
join specialty ON surgeon.specialty_id = specialty.specialty_id
join item_master ON scic.item_id = item_master.item_id
WHERE 1 = surgeon.provider_id
	AND 1 = surgeon.location_id
ORDER BY CASE 'I' WHEN 'I' THEN card.description ELSE NULL END, item_master.description</CommandText></Query><Fields><Field Name="ItemName"><DataField>ItemName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Specialty"><DataField>Specialty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ItemCost"><DataField>ItemCost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="CardName"><DataField>CardName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CardQuantity"><DataField>CardQuantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TotalUsed"><DataField>TotalUsed</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>6.91667in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Specialty"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Specialty.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Specialty</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>8.96875in</Height><TablixCells><TablixCell><CellContents><Chart Name="Chart1"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart1_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!ItemName.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!ItemName.Value</Value></SortExpression></SortExpressions><Label>=Fields!ItemName.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Total Used</Label></ChartMember><ChartMember><Label>Item Cost</Label></ChartMember><ChartMember><Label>Card Quantity</Label></ChartMember><ChartMember><Label>Item Name</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="AvgUsed"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Avg(Fields!TotalUsed.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><Format>0.#</Format><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ChartItemInLegend><LegendText>Avg Used</LegendText></ChartItemInLegend><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="instrument_cost"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Max(Fields!ItemCost.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><Format>0.#</Format><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="tray_quantity"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Max(Fields!CardQuantity.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><Format>0.#</Format><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="ItemName"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Count(Fields!ItemName.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ChartItemInLegend><LegendText>Nbr Counts</LegendText></ChartItemInLegend><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><Border><Colo