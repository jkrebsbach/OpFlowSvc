<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="OpFlow"><DataSourceReference>OpFlow</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3e07071b-ea4d-4a16-8fef-b74011888c61</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="SupplyWaste"><Query><DataSourceName>OpFlow</DataSourceName><CommandText>select top 10 instrument_master.description InstrumentName,
	instrument_master.instrument_cost InstrumentCost,
	card.description CardName,
	ti.quantity TrayQuantity,
	vw.total_used TotalUsed
from card_instrument_usage_view vw
join tray_instruments ti ON ti.instrument_id = vw.instrument_id AND
	ti.tray_item_id = vw.tray_item_id
join card ON vw.card_id = card.card_id
join instrument_master ON vw.instrument_id = instrument_master.instrument_id
</CommandText></Query><Fields><Field Name="InstrumentName"><DataField>InstrumentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="InstrumentCost"><DataField>InstrumentCost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="CardName"><DataField>CardName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TrayQuantity"><DataField>TrayQuantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TotalUsed"><DataField>TotalUsed</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Chart Name="Chart1"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart1_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!InstrumentName.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!InstrumentName.Value</Value></SortExpression></SortExpressions><Label>=Fields!InstrumentName.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Total Used</Label></ChartMember><ChartMember><Label>Instrument Cost</Label></ChartMember><ChartMember><Label>Tray Quantity</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="AvgUsed"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Avg(Fields!TotalUsed.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ChartItemInLegend><LegendText>Avg Used</LegendText></ChartItemInLegend><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="instrument_cost"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!InstrumentCost.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="tray_quantity"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!TrayQuantity.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><St