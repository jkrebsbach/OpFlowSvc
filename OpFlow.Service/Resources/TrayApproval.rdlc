<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OpFlow">
      <DataSourceReference>OpFlow</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>06cf4dd4-3a84-4d41-9df3-0a0d0e159e1e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ProposedTray">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'a' TrayName,
5 InstrumentCount</CommandText>
      </Query>
      <Fields>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstrumentCount">
          <DataField>InstrumentCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SourceTrays">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'a' TrayName,
5 InstrumentCount,
6 CountChange,
1.23 PcntChange</CommandText>
      </Query>
      <Fields>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstrumentCount">
          <DataField>InstrumentCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CountChange">
          <DataField>CountChange</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PcntChange">
          <DataField>PcntChange</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TrayInstruments">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'a' TrayName,
'n' InstrumentName,
6 Quantity</CommandText>
      </Query>
      <Fields>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstrumentName">
          <DataField>InstrumentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TrayCounts">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'a' Trayname,
'n' Surgeon,
5 Times,
'a' [Procedure],
'a' CptCodes,
GetDate() SurgeryDate,
6 QtyUsed</CommandText>
      </Query>
      <Fields>
        <Field Name="Trayname">
          <DataField>Trayname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Surgeon">
          <DataField>Surgeon</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Times">
          <DataField>Times</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Procedure">
          <DataField>Procedure</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CptCodes">
          <DataField>CptCodes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SurgeryDate">
          <DataField>SurgeryDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="QtyUsed">
          <DataField>QtyUsed</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Audits">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'a' AuditUser,
'a' SurgeonName,
'b' [Procedure],
'aaa' CptCode1,
'bbb' CptCode2,
'ccc' CptCode3,
GetDate() ScheduleTime,
5 UsedInstruments,
'aa' AuditComments</CommandText>
      </Query>
      <Fields>
        <Field Name="AuditUser">
          <DataField>AuditUser</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SurgeonName">
          <DataField>SurgeonName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Procedure">
          <DataField>Procedure</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CptCode1">
          <DataField>CptCode1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CptCode2">
          <DataField>CptCode2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CptCode3">
          <DataField>CptCode3</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ScheduleTime">
          <DataField>ScheduleTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="UsedInstruments">
          <DataField>UsedInstruments</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AuditComments">
          <DataField>AuditComments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Instruments">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 5 Sequence,
'a' InstrumentName,
'b' TrayName,
6 SourceQty,
7.2 AvgUsed,
'aa' Reason,
5 Quantity,
'aa' Comments</CommandText>
      </Query>
      <Fields>
        <Field Name="Sequence">
          <DataField>Sequence</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InstrumentName">
          <DataField>InstrumentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceQty">
          <DataField>SourceQty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AvgUsed">
          <DataField>AvgUsed</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Reason">
          <DataField>Reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Comments">
          <DataField>Comments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Cards">
      <Query>
        <DataSourceName>OpFlow</DataSourceName>
        <CommandText>select 'a' SpecialtyName,
'a' CardDescription,
'b' SurgeonName,
'c' TrayName,
7 CountsComplete,
7 AuditsComplete</CommandText>
      </Query>
      <Fields>
        <Field Name="SpecialtyName">
          <DataField>SpecialtyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CardDescription">
          <DataField>CardDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SurgeonName">
          <DataField>SurgeonName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TrayName">
          <DataField>TrayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CountsComplete">
          <DataField>CountsComplete</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AuditsComplete">
          <DataField>AuditsComplete</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
