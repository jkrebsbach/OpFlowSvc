<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="OpFlow"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>Data Source=opflow.database.windows.net;Initial Catalog=OpFlow</ConnectString><Prompt>Specify a user name and password for data source OpFlow:</Prompt></ConnectionProperties><rd:SecurityType>DataBase</rd:SecurityType><rd:DataSourceID>aaf72f52-fbd2-4a83-9ee0-c295afd65466</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="TrayRationalization"><Query><DataSourceName>OpFlow</DataSourceName><CommandText>
SELECT TrayName,
	SUM(CaseCount) CaseCount,
	MAX(InstrumentCount) InstrumentCount,
	AVG(UsageQuantity ) UsageQuantity,
	SUM(TrayOpened) TrayOpened
FROM tray_rationalization_view
WHERE SpecialtyID=1
GROUP BY TrayName
ORDER BY TrayName</CommandText></Query><Fields><Field Name="TrayName"><DataField>TrayName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CaseCount"><DataField>CaseCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="InstrumentCount"><DataField>InstrumentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="UsageQuantity"><DataField>UsageQuantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TrayOpened"><DataField>TrayOpened</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Chart Name="Chart2"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart2_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!TrayName.Value</GroupExpression></GroupExpressions></Group><Label>=Fields!TrayName.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Case Count</Label></ChartMember><ChartMember><Label>Instrument Count</Label></ChartMember><ChartMember><Label>Usage Quantity</Label></ChartMember><ChartMember><Label>Tray Opened</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="CaseCount"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!CaseCount.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLine