<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="OpFlow"><DataSourceReference>OpFlow</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>bbb82fb5-72e1-4b01-a93f-ca2052ab005b</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="TrayScope"><Query><DataSourceName>OpFlow</DataSourceName><CommandText>SELECT tray.tray_name TrayName,
	specialty.description SpecialtyName,
	card.description CardName,
	SUM(tray_audit) TrayAudits,
	SUM(tray_count) TrayCounts
FROM surgery
JOIN users surgeon ON surgery.user_id = surgeon.user_id
JOIN specialty ON surgeon.specialty_id = specialty.specialty_id
JOIN card ON surgery.card_id = card.card_id
JOIN card_item ON card.card_id = card_item.card_id
JOIN tray ON card_item.item_id = tray.tray_item_id
LEFT JOIN (
	select surgery_id, tray_item_id, 1 tray_count
	from surgery_tray
	where tray_opened = 1	
	) tray_counts ON tray.tray_item_id = tray_counts.tray_item_id
LEFT JOIN (
	select surgery_id, count(*) tray_audit
	from tray_proposal_audit
	where audit_user_id IS NOT NULL
	group by surgery_id
	) tray_audits ON surgery.surgery_id = tray_audits.surgery_id
WHERE tray.tray_item_id = 59141
	AND 1 = tray.location_id
	AND 1 = tray.provider_id

GROUP BY tray.tray_name, specialty.description, card.description
ORDER BY tray.tray_name</CommandText></Query><Fields><Field Name="TrayName"><DataField>TrayName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SpecialtyName"><DataField>SpecialtyName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CardName"><DataField>CardName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TrayAudits"><DataField>TrayAudits</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TrayCounts"><DataField>TrayCounts</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>6.5in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Tray Scope</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="TrayName2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Tray: " + Fields!TrayName.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>TrayName2</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="SpecialtyName1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Specialty: " + Fields!SpecialtyName.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>SpecialtyName1</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>6.125in</Height><TablixCells><TablixCell><CellContents><Chart Name="Chart1"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart1_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!CardName.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!CardName.Value</Value></SortExpression></SortExpressions><Label>=Fields!CardName.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Tray Counts</Label></ChartMember><ChartMember><Label>Tray Audits</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="CaseCount"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!TrayCounts.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="TrayAudits"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!TrayAudits.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style><UseValueAsLabel>true</UseValueAsLabel><Visible>true</Visible></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style><FontFamily>Segoe UI</FontFamily></Style></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontSize>8pt</FontSize><Color>#5c5c5c</Color><FontFamily>Segoe UI</FontFamily></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color><FontFamily>Segoe UI</FontFamily></Style></ChartAxisTitle><Interval>1</Interval><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Min